# Copy this file to .env and adjust values for your environment.
# .env is gitignored; never commit real secrets.

# SQLAlchemy async database URL.
# Local dev (file-based, persists across restarts):
DATABASE_URL=sqlite+aiosqlite:///./sql_app.db
# Postgres example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/idees_voyages

# Long, random secret used to sign JWTs and password reset/verification tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed CORS origins, or "*" for any origin (dev only).
CORS_ORIGINS=*
